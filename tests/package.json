{
  "name": "local-proctoring-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run format:check && npm run lint && node ../scripts/check-release-version.js && npm run test:unit && npm run test:contract && npm run test:ui",
    "test:unit": "node --experimental-vm-modules --test unit/*.test.js",
    "test:coverage": "node --experimental-vm-modules --experimental-test-coverage --test unit/*.test.js",
    "test:ui": "playwright test",
    "test:ui:list": "playwright test --list --reporter=list",
    "test:ui:repeat": "playwright test --repeat-each=2",
    "format": "prettier --write \"{unit,contract,ui,fixtures,support,pages,flows,mocks}/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"{unit,contract,ui,fixtures,support,pages,flows,mocks}/**/*.js\" \"*.{js,json}\"",
    "test:contract": "node --test contract/*.test.js",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
